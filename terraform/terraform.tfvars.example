# Copy to terraform.tfvars (gitignored) when you are ready for AWS.
# Reuses the existing neo-atari EC2 key pair + ~/.ssh/neo-atari.pem for speed
# (same account/region as atari-keyboard). Create a dedicated nes key later if
# you want isolation; update key_name and --ssh-key accordingly.
enable_aws       = true
aws_region       = "us-east-2"
key_name         = "neo-atari"
ssh_ingress_cidr = "203.0.113.10/32" # replace with your public IP /32
# Ignored for ingress. VNC stays on 127.0.0.1:5901 and is reached through SSH.
enable_vnc       = true
instance_type    = "t3.small"
